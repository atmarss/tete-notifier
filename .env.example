# 特特管家推送配置
API_TOKEN=your_tete_guanjia_token_here

# Teslamate 数据库（docker-compose 中 service 名必须是 database）
DATABASE_HOST=database
DATABASE_USER=teslamate
DATABASE_PASS=your_secure_password
DATABASE_NAME=teslamate
DATABASE_PORT=5432

# MQTT（docker-compose 中 service 名必须是 mosquitto）
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_USER=   # 留空或填你的用户名
MQTT_PASS=   # 留空或填你的密码

# 其他配置
CAR_ID=1                    # 你的车辆ID，默认1
LOG_LEVEL=info              # debug / info / warn
PUSH_DEBOUNCE_SECONDS=5    # 推送防抖动初始时间

# 车辆启动通知（P档切换到D档，且持续D档一段时间后推送）
ENABLE_START_NOTIFY=true   # 是否开启启动通知，默认 true
START_CONFIRM_SECONDS=10   # P->D 后需持续 D 档的确认秒数，默认 10
START_NOTIFY_COOLDOWN_SECONDS=60  # 启动通知冷却时间（秒），避免重复推送，默认 60

# 车门打开通知
ENABLE_DOOR_NOTIFY=true    # 是否开启车门打开通知，默认 true
DOOR_NOTIFY_COOLDOWN_SECONDS=60    # 开门通知冷却时间（秒），默认 60
DOOR_NOTIFY_P_DURATION_SECONDS=300 # 需持续 P 档多久后开门才通知（秒），默认 300（5分钟）；避免刚停车正常下车时误报

# 充满电通知（charging_state=Complete 时单独推送"已充满"，关闭则回退到原"充电完成"通知）
ENABLE_FULL_CHARGE_NOTIFY=true  # 是否开启充满电通知，默认 true

# 忘记锁车通知（长时间 P 档停放且未锁时推送）
ENABLE_UNLOCK_NOTIFY=true       # 是否开启忘记锁车通知，默认 true
UNLOCK_NOTIFY_DELAY_SECONDS=120 # 检测到未锁后持续多久复核（秒），默认 120
UNLOCK_NOTIFY_COOLDOWN_SECONDS=600 # 忘锁通知冷却时间（秒），默认 600（10分钟）

# 行程通知起终点（显示"始: X → 终: Y"，从 Teslamate 地理围栏/反向地理编码读取，取不到时自动省略）
ENABLE_TRIP_ORIGIN=true          # 是否在行程通知中显示起点到终点，默认 true